{
  "manifest_version": 3,
  "name": "Quiz Tutor AI – Ôn trắc nghiệm",
  "version": "2.1.0",
  "description": "Quét trang trắc nghiệm, dùng Gemini chọn đáp án và giải thích chi tiết để học thuộc. Nút tròn nổi + ô đáp án đè lên từng câu hỏi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Cài đặt Quiz Tutor AI"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "2.1.0-dev"
}